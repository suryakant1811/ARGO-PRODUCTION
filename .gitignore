
# Terraform directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Sensitive files
*.pem
*.key
*.secret
.env
.env.*

# Plan files
*.tfplan
*.plan

# Editor and OS files
.vscode/
.idea/
.DS_Store


# Ignore Terraform working directories everywhere
.terraform/
**/.terraform/**

# Ignore Terraform state files everywhere
*.tfstate
*.tfstate.*

# Ignore Terraform plans and variable files
*.tfplan
*.tfvars
*.tfvars.json

# Ignore downloaded kubectl binaries
terraform/kubectl
terraform/kubectl.sha256
