// This job runs on the Jenkins agent. An AWS login on your laptop is not used here.
pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '397745287775.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPO = 'merchant_devops/northline'
        IMAGE = '397745287775.dkr.ecr.ap-south-1.amazonaws.com/merchant_devops/northline'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('ECR login') {
            steps {
                sh '''
                    aws ecr get-login-password --region "$AWS_REGION" \
                      | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -f ARGO-PRODUCTION/application/dockerfile -t $IMAGE:$BUILD_NUMBER ARGO-PRODUCTION/application'
            }
        }

        stage('Push') {
            steps {
                sh 'docker push $IMAGE:$BUILD_NUMBER'
            }
        }
    }

    post {
        success {
            echo "Pushed ${env.IMAGE}:${env.BUILD_NUMBER}"
        }
    }
}
