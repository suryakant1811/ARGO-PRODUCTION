pipeline {
    agent any

    environment {
        IMAGE = '397745287775.dkr.ecr.ap-south-1.amazonaws.com/merchant_devops/northline'
    }

    stages {
        stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/suryakant1811/ARGO-PRODUCTION.git'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -f application/dockerfile -t $IMAGE:$BUILD_NUMBER application'
            }
        }

        stage('Push') {
            steps {
                sh 'aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 397745287775.dkr.ecr.ap-south-1.amazonaws.com'
                sh 'docker push $IMAGE:$BUILD_NUMBER'
            }
        }
    }
}
